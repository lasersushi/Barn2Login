# Barn2 Sign-In — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored (.gitignore: `.env*`).
# NEVER prefix any of these with NEXT_PUBLIC_ — that inlines the value into the
# client bundle at build time and ships the secret to every browser.
#
# Every value here must ALSO be added in the Vercel dashboard
# (Project → Settings → Environment Variables → Production).
# `.env.local` is local only; it does not reach Vercel.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Dashboard → Connect → "Transaction pooler".
# MUST be port 6543 (transaction mode), NOT 5432 (session mode).
# Transaction mode does not support prepared statements, which is why
# src/db/client.ts passes `prepare: false` to postgres().
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Dashboard → Settings → API. Unused in phase 1 (we talk to Postgres directly,
# never PostgREST), kept for future Supabase Storage use.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Discord  (discord.com/developers/applications)
# ---------------------------------------------------------------------------

# General Information → Public Key. Used to verify request signatures.
DISCORD_PUBLIC_KEY=""

# Bot → Token ("Reset Token" to reveal). Used to register slash commands.
DISCORD_BOT_TOKEN=""

# General Information → Application ID.
DISCORD_APPLICATION_ID=""

# Your team's Discord server ID. Enable Developer Mode in Discord
# (Settings → Advanced), then right-click the server icon → Copy Server ID.
# Commands are registered guild-scoped during development because they
# propagate instantly; global commands take up to an hour.
DISCORD_GUILD_ID=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# Base URL used to build the one-time redeem links sent to members.
# Must be the BARE Vercel project alias. The per-deploy URL and the
# team-suffixed alias are both behind Vercel Deployment Protection and
# return a 302 to an SSO login page.
# Locally, set this to http://localhost:3000
APP_BASE_URL="https://barn2-login.vercel.app"
